/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Simulator.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_SIMULATOR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Project...\tCtrl+O",    ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Open in &Editor\tCtrl+Shift+O", ID_FILE_OPENINEDITOR
        MENUITEM "Show Project &Files",         ID_FILE_SHOW_PROJECT_FILES
        MENUITEM "Show Project &Sandbox",       ID_FILE_SHOWPROJECTSANDBOX
        MENUITEM SEPARATOR
        MENUITEM "Clear Project Sandbox",       ID_FILE_CLEARPROJECTSANDBOX
        MENUITEM SEPARATOR
        MENUITEM "&Relaunch\tCtrl+R",           ID_FILE_RELAUNCH
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "H&ardware"
    BEGIN
        MENUITEM "&Back\tAlt+Left",             ID_VIEW_NAVIGATE_BACK
        MENUITEM SEPARATOR
        MENUITEM "Suspend\tCtrl+Down Arrow",    ID_VIEW_SUSPEND
    END
    POPUP "&View"
    BEGIN
        POPUP "View &As"
        BEGIN
            MENUITEM "Placeholder",                 ID_VIEWAS_BEGIN
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Online &Documentation...",    ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About Simulator...",         ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPENINEDITOR,   VIRTKEY, SHIFT, CONTROL, NOINVERT
    "R",            ID_FILE_RELAUNCH,       VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_VIEW_SUSPEND,        VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_VIEW_SUSPEND,        VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_LEFT,        ID_VIEW_NAVIGATE_BACK,  VIRTKEY, ALT, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 221, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Solar2D Simulator"
FONT 9, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,20,20
    LTEXT           "Solar2D Simulator",IDC_STATIC,39,14,149,8,SS_NOPREFIX
    LTEXT           "<Copyright>",IDC_COPYRIGHT,39,39,175,16
    DEFPUSHBUTTON   "OK",IDOK,164,64,50,14,WS_GROUP
    CONTROL         "<a href=""https://solar2d.com"">https://solar2d.com</a>",IDC_LINK_ANSCAMOBILE,
                    "SysLink",WS_TABSTOP,39,52,132,10
    LTEXT           "<Version>",IDC_ABOUT_VERSION,39,26,160,8
END

IDD_MESSAGE DIALOGEX 0, 0, 253, 71
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Solar2D Simulator"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,166,50,80,14
    ICON            "",IDC_MSG_ICON,7,7,20,20
    LTEXT           "Static",IDC_MSG_TEXT,53,5,193,40
    PUSHBUTTON      "Alt",ID_MSG_BUTTON2,75,50,80,14
END


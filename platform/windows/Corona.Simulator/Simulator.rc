/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Simulator.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_SIMULATOR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Project...\tCtrl+O",    ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Open in &Editor\tCtrl+Shift+O", ID_FILE_OPENINEDITOR
        MENUITEM "Show Project &Files",         ID_FILE_SHOW_PROJECT_FILES
        MENUITEM "Show Project &Sandbox",       ID_FILE_SHOWPROJECTSANDBOX
        MENUITEM SEPARATOR
        MENUITEM "Clear Project Sandbox",       ID_FILE_CLEARPROJECTSANDBOX
        MENUITEM SEPARATOR
        MENUITEM "&Relaunch\tCtrl+R",           ID_FILE_RELAUNCH
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "H&ardware"
    BEGIN
        MENUITEM "&Back\tAlt+Left",             ID_VIEW_NAVIGATE_BACK
        MENUITEM SEPARATOR
        MENUITEM "Suspend\tCtrl+Down Arrow",    ID_VIEW_SUSPEND
    END
    POPUP "&View"
    BEGIN
        POPUP "View &As"
        BEGIN
            MENUITEM "Placeholder",                 ID_VIEWAS_BEGIN
        END
        MENUITEM SEPARATOR
        MENUITEM "&Console",                    ID_VIEW_CONSOLE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Online &Documentation...",    ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About Simulator...",         ID_APP_ABOUT
    END
END



    "R",            ID_FILE_RELAUNCH,       VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_VIEW_SUSPEND,        VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_VIEW_SUSPEND,        VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_LEFT,        ID_VIEW_NAVIGATE_BACK,  VIRTKEY, ALT, NOINVERT
END



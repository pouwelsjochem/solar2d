    CONTROL         "Height :",IDC_SCREEN_HEIGHT_LABEL,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,222,96,42,8,WS_EX_RIGHT
    EDITTEXT        IDC_SCREEN_HEIGHT_EDIT_BOX,270,96,54,14,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "",IDC_DIVIDING_LINE,6,216,324,2,0,WS_EX_STATICEDGE

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x37L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Solar2D"
            VALUE "FileDescription", "Solar2D Simulator"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "Solar2D Simulator"
            VALUE "LegalCopyright", "Copyright © 2020-2021 Solar2D"
            VALUE "OriginalFilename", "Solar2D Simulator"
            VALUE "ProductName", "Solar2D Simulator"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END



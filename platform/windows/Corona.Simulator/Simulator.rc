    LTEXT           "Application using the physics and composer APIs.",IDC_TEMPLATE_GAME_LABEL,24,146,158,8,NOT WS_GROUP
    LTEXT           "Multi-page interface using the composer API.",IDC_TEMPLATE_EBOOK_LABEL,24,182,145,8,NOT WS_GROUP
    GROUPBOX        "Screen Size",IDC_SCREEN_SIZE_GROUP_BOX,216,48,114,66
    COMBOBOX        IDC_SCREEN_SIZE_COMBO_BOX,222,60,102,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Width :",IDC_SCREEN_WIDTH_LABEL,222,78,42,8,0,WS_EX_RIGHT
